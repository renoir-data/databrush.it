---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// Auto-detect columns based on number of items if not specified
const autoColumns = columns ?? Math.min(items.length, 3);
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />
  <ItemGrid2
    items={items}
    columns={autoColumns}
    defaultIcon={defaultIcon}
    classes={{
      container: `gap-6 md:gap-8 ${items.length === 2 ? 'justify-items-center' : ''}`,
      panel:
        'border-[3px] border-black dark:border-white rounded-none bg-white dark:bg-slate-900 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] dark:shadow-[4px_4px_0px_0px_rgba(255,255,255,1)] p-6 hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[6px_6px_0px_0px_rgba(255,255,255,1)] transition-all duration-150',
      icon: 'w-12 h-12 mb-6 text-black dark:text-white bg-primary p-2 border-2 border-black dark:border-white rounded-none flex-shrink-0',
      ...((classes?.items as Record<string, never>) ?? {}),
    }}
  />
  {Astro.slots.has('footer') && (
    <div class="flex justify-center mt-8 md:mt-12">
      <slot name="footer" />
    </div>
  )}
</WidgetWrapper>
