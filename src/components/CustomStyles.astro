---
import '@fontsource/space-grotesk';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---


<style is:inline>
  :root {
    --aw-font-sans: 'Space Grotesk', sans-serif;
    --aw-font-serif: 'Space Grotesk', sans-serif;
    --aw-font-heading: 'Space Grotesk', sans-serif;

    --aw-color-primary: rgb(38, 233, 175); /* #26E9AF */
    --aw-color-secondary: rgb(175, 74, 212); /* #AF4AD4 */
    --aw-color-accent: rgb(175, 74, 212); /* #AF4AD4 */

    --aw-color-text-heading: rgb(0,0,0);
    --aw-color-text-default: rgb(0,0,0);
    --aw-color-text-muted: rgb(0 0 0 / 80%);
    --aw-color-bg-page: rgb(251, 250, 245);
    --aw-color-bg-page-alpha: rgba(251, 250, 245, 0.3);

    --aw-color-bg-page-dark: rgb(18, 18, 18);
    --aw-color-bg-page-dark-alpha: rgba(18, 18, 18, 0.3);

    --breakpoint-xs: 30rem;

    ::selection {
      background-color: rgb(38, 233, 175);
      color: black;
    }
  }

  .dark {
    --aw-font-sans: 'Space Grotesk', sans-serif;
    --aw-font-serif: 'Space Grotesk', sans-serif;
    --aw-font-heading: 'Space Grotesk', sans-serif;

    --aw-color-primary: rgb(38, 233, 175);
    --aw-color-secondary: rgb(175, 74, 212);
    --aw-color-accent: rgb(175, 74, 212);

    --aw-color-text-heading: rgb(255, 255, 255);
    --aw-color-text-default: rgb(240, 240, 240);
    --aw-color-text-muted: rgb(240 240 240 / 70%);
    --aw-color-bg-page: rgb(18, 18, 18);
    --aw-color-bg-page-alpha: rgba(18, 18, 18, 0.3);

    --breakpoint-xs: 30rem;

    ::selection {
      background-color: rgb(175, 74, 212);
      color: white;
    }
  }
</style>

